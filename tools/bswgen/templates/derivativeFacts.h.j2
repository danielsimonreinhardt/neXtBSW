// Generated by tools/bswgen from {{ source }} - do not edit.
// ARCH-16: hardware facts of the derivative (mcudb <family>/<derivative>.yaml) that the family code and the board
// port need as numbers. Nothing here is a board or a project value, and nothing here may be written by hand: the
// evidence of every value is the `source` of its entry in the derivative database.
// C and C++, no include of its own, so the family mcu.h can use it before any device header.

#pragma once

// ARCH-24: core of {{ irq.derivative }} ({{ irq.core }}, mcudb derivative.core -> tools/nxconfig config.CORES). Code
// that differs between core profiles selects on these macros, never on __ARM_ARCH: GCC defines it as 7 for
// Cortex-M4F and Cortex-R4F alike (finding ARCH-19).
#define {{ core.architecture_macro }} 1
#define {{ core.controller_macro }} 1

{% if irq.controller == "nvic" %}
// NVIC priority bits {{ irq.derivative }} ({{ irq.core }}) implements: levels 0 (highest) .. {{ irq.levels - 1 }} (lowest).
// mcudb derivative.nvic_priority_bits. The device header is not the source: S32K116.h claims 4 while the core has 2
// (PLAT-10); interrupts/nxInterruptPriority.h compares both and stops the build on a mismatch.
#define NX_NVIC_PRIORITY_BITS {{ irq.bits }}
{% else %}
// VIM of {{ irq.derivative }} (mcudb vim): channels 0 (highest priority) .. {{ irq.channels - 1 }}, the priority is the channel number.
// Fixed channels (not available to interrupt ranks): {{ irq.fixed|join(', ') if irq.fixed else 'none' }}.
#define NX_VIM_CHANNEL_COUNT {{ irq.channels }}
#define NX_VIM_FIXED_CHANNEL_COUNT {{ irq.fixed|length }}
{% for mask in irq.fixed_masks %}
#define NX_VIM_FIXED_MASK{{ loop.index0 }} {{ mask }}
{% endfor %}
{% endif %}

// PLAT-12: ADC converters of {{ irq.derivative }} (mcudb instances with class adc, the ones the family driver
// bsp/adc/AnalogInput.cpp knows: {{ adc_converters|join(', ') }}). The family port held two of them (ADC0 and
// ADC1) and did not compile for a derivative with one converter (S32K116: only ADC0).
#define NX_ADC_INSTANCE_COUNT {{ adc_converters|length }}

{% if mpu %}
// Region descriptors of the MPU of {{ irq.derivative }} (mcudb mpu.regions): RGD[0..{{ mpu.regions - 1 }}].
// The device header is not the source either, because it may describe a larger derivative: the S32K144 builds with
// the S32K148 header, whose RGD[] has 16 entries while the silicon implements 8 - accesses above the implemented
// ones end in a bus fault.
#define NX_MPU_REGIONS {{ mpu.regions }}
// Value the hardware reports in MPU_CESR[NRGD] for {{ mpu.regions }} region descriptors (register encoding of the
// family, tools/bswgen MPU_NRGD_CODES: 0 = 8, 1 = 12, 2 = 16).
#define NX_MPU_CESR_NRGD {{ mpu.nrgd }}
{% else %}
// {{ irq.derivative }} describes no MPU in the derivative database (mcudb mpu): NX_MPU_REGIONS and
// NX_MPU_CESR_NRGD stay undefined, so code that needs the MPU stops with an #error instead of assuming a
// region count (finding ARCH-09 B3).
{% endif %}
