{% for sensor in task_hall_sensors %}
        ::bios::HallSensors::Reading const hall_{{ sensor }}
            = ::bios::HallSensors::get(::bios::hall::Hi_{{ sensor }});
{% endfor %}
{% for b in hall_inputs %}
{% if b.io_task is sameas task %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(hall_{{ b.bsw_signal }}.{{ hall_fields[b.bsw] }});
{% endif %}
{% endfor %}
    }
{% endif %}
{% if pinevent_cycle_task is sameas task %}
    // Pin events (IO-54), task side: re-arms an input the rate limit switched off once its hold-off has passed and
    // expires a quiet history - every cycle of this one task (bsp/pinIrq/PinIrqConfig.h)
    ::bsp::cyclePinEvents();
{% endif %}
{% set task_pin_events = pinevent_reads[task.name] %}
{% if task_pin_events %}
    {
        // Pin events (IO-54): counter of accepted edges, time stamp of the last one and quality, counted in the pin
        // interrupt (libs/bsp/bspPinEvent). read() takes a consistent lock-free copy; if an interrupt wrote during
        // every attempt it returns false and the values of the cycle before stay (pinevent.<Input>.qlf: QLF_OK,
        // QLF_DEBOUNCE before the first edge, QLF_ERROR while the rate limit keeps the input off).
{% for name in task_pin_events %}
        ::pinevent::Reading pinevent_{{ name }}{};
        if (::bsp::pinEvents().read(::pinevent::project::Pe_{{ name }}, pinevent_{{ name }}))
        {
{% for b in pinevent_inputs %}
{% if b.io_task is sameas task and b.bsw_signal == name %}
            {{ b.io_ref }} = static_cast<{{ b.ctype }}>(pinevent_{{ name }}.{{ pinevent_fields[b.bsw] }});
{% endif %}
{% endfor %}
        }
{% endfor %}
    }
{% endif %}
{% set task_gate_drivers = gd_reads[task.name] %}
{% if task_gate_drivers %}
    {
        // Gate drivers (IO-25): fault bits latched by the driver, DRV_EN state and the health of the driver as
        // qualifier (QLF_OK running, QLF_ERROR communication or device error, QLF_DEBOUNCE not started yet).
{% for device in task_gate_drivers %}
        uint16_t gd_{{ device }}_faults = 0U;
        bool gd_{{ device }}_enabled     = false;
        uint8_t gd_{{ device }}_health   = 0U;
        ::integration::rte::readGateDriver_{{ device }}(gd_{{ device }}_faults, gd_{{ device }}_enabled, gd_{{ device }}_health);
        uint8_t const gd_{{ device }}_health_qlf = (gd_{{ device }}_health == 1U)   ? {{ gd_health[1] }}
                                                 : (gd_{{ device }}_health == 2U) ? {{ gd_health[2] }}
                                                                                  : {{ gd_health[0] }};
{% set bus = gd_bus.get(device) %}
{% if bus %}
        // SYS-29 (G5, F5): the safe supervisor's verdict on the bus comes on top of the driver's own health
        uint8_t const gd_{{ device }}_quality
            = ::safety::device::rte::busLost({{ bus }}) ? QLF_ERROR : gd_{{ device }}_health_qlf;
{% else %}
        uint8_t const gd_{{ device }}_quality = gd_{{ device }}_health_qlf; // SYS-29: no single bus, no bus verdict
{% endif %}
{% endfor %}
{% for b in gd_inputs %}
{% if b.io_task is sameas task %}
{% if gd_fields[b.bsw] == "enabled" %}
        {{ b.io_ref }} = gd_{{ b.bsw_signal }}_enabled ? 1U : 0U;
{% else %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(gd_{{ b.bsw_signal }}_{{ gd_fields[b.bsw] }});
{% endif %}
{% endif %}
{% endfor %}
    }
{% endif %}
{% for source in reading_sources %}
{% set task_instances = source.reads[task.name] %}
{% if task_instances %}
    {
        // {{ source.module }} (module.yaml rte, RTE-18): one reading per instance holds every value of it{% if source.qualifier %};
        // {{ source.prefix }}.<{{ source.instance }}>.{{ source.qualifier }} says whether the values are current{% endif %}

{% for instance in task_instances %}
        {{ source.reading }} {{ source.prefix }}_{{ instance }}{};
        ::integration::rte::{{ source.read }}_{{ instance }}({{ source.prefix }}_{{ instance }});
{% endfor %}
{% for b in source.inputs %}
{% if b.io_task is sameas task and b.ctype == "boolean" %}
        {{ b.io_ref }} = {{ source.prefix }}_{{ b.bsw_signal }}.{{ source.fields[b.bsw] }} ? 1U : 0U;
{% elif b.io_task is sameas task %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>({{ source.prefix }}_{{ b.bsw_signal }}.{{ source.fields[b.bsw] }});
{% endif %}
{% endfor %}
    }
{% endif %}
{% endfor %}
{% set task_ecu_inputs = ecu_inputs | selectattr("io_task", "sameas", task) | list %}
{% if task_ecu_inputs %}
    {
        // ECU state management (ecu.state, ecu.wakeup, ecu.wakeup.<source>)
{% if task_ecu_inputs | selectattr("bsw", "equalto", "ecu.state") | list %}
        uint8_t state = 0U;
        ::ecustate::rte::readState(state);
{% endif %}
{% if task_ecu_inputs | rejectattr("bsw", "equalto", "ecu.state") | list %}
        uint32_t wakeup = 0U;
        ::ecustate::rte::readWakeupSources(wakeup);
{% endif %}
{% for b in task_ecu_inputs %}
{% if b.bsw == "ecu.state" %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(state);
{% elif b.bsw == "ecu.wakeup" %}
        {{ b.io_ref }} = wakeup;
{% else %}
        {{ b.io_ref }} = ((wakeup & {{ b.bsw_signal }}) != 0U) ? 1U : 0U;
{% endif %}
{% endfor %}
    }
{% endif %}
{% set task_safety_inputs = safety_inputs | selectattr("io_task", "sameas", task) | list %}
{% if task_safety_inputs %}
    {
        // SYS-117: degraded safe-output groups (safety.degraded, safety.degraded.<GROUP>, safety.qlf.degraded)
        uint32_t degraded = 0U;
{% if task_safety_inputs | selectattr("bsw", "equalto", "safety.qlf.degraded") | list %}
        bool const degradedPlausible = ::safety::degraded::rte::readGroups(degraded);
{% else %}
        (void)::safety::degraded::rte::readGroups(degraded); // implausible: every bit reads 1
{% endif %}
{% for b in task_safety_inputs %}
{% if b.bsw == "safety.degraded" %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(degraded);
{% elif b.bsw == "safety.degraded." %}
        {{ b.io_ref }} = ((degraded & {{ b.bsw_signal }}) != 0U) ? 1U : 0U;
{% else %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(degradedPlausible ? {{ qlf.OK }}U : {{ qlf.ERROR }}U);
{% endif %}
{% endfor %}
    }
{% endif %}
{% set task_hw_shutoff = hw_shutoff_inputs | selectattr("io_task", "sameas", task) | list %}
{% if task_hw_shutoff %}
    {
        // SYS-136: hardware shut-off path reported to the safe supervisor (safety.hw_shutoff, safety.qlf.hw_shutoff)
        uint32_t hwShutoff = 0U;
{% if task_hw_shutoff | selectattr("bsw", "equalto", "safety.qlf.hw_shutoff") | list %}
        bool const hwShutoffPlausible = ::safety::hwShutoff::read(hwShutoff);
{% else %}
        (void)::safety::hwShutoff::read(hwShutoff); // implausible: the word reads 0xFFFFFFFF
{% endif %}
{% for b in task_hw_shutoff %}
{% if b.bsw == "safety.qlf.hw_shutoff" %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(hwShutoffPlausible ? {{ qlf.OK }}U : {{ qlf.ERROR }}U);
{% elif b.ctype == "boolean" %}
        {{ b.io_ref }} = (hwShutoff != 0U) ? 1U : 0U;
{% else %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(hwShutoff);
{% endif %}
{% endfor %}
    }
{% endif %}
{% set task_safe_state = safe_state_inputs | selectattr("io_task", "sameas", task) | list %}
{% if task_safe_state %}
    {
        // SYS-141: safe state of the PWM groups (safety.safe_state_active.<GROUP>, safety.qlf.safe_state.<GROUP>)
{% for name in task_safe_state | map(attribute="bsw_name") | unique %}
{% set group = safe_state_groups[name] %}
        uint32_t safeState_{{ group.ident }}       = 0U;
        bool safeStateInForce_{{ group.ident }}    = false;
        ::safestate::rte::read({{ group.index }}U, {{ group.mask }}, safeState_{{ group.ident }}, safeStateInForce_{{ group.ident }});
{% endfor %}
{% for b in task_safe_state %}
{% set group = safe_state_groups[b.bsw_name] %}
{% if b.bsw == "safety.qlf.safe_state." %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(safeStateInForce_{{ group.ident }} ? {{ qlf.OK }}U : {{ qlf.ERROR }}U);
{% else %}
        {{ b.io_ref }} = static_cast<{{ b.ctype }}>(safeState_{{ group.ident }});
{% endif %}
{% endfor %}
    }
{% endif %}
{% set task_services = bsw_reads[task.name] %}
{% if task_services %}
    {
        // BSW service ports (RTE-05, bsw.<service>.<value>): one reading per service and cycle, so all values of a
        // service belong together and every port of this task sees the same instant.
{% for name in task_services %}
{% set service = bsw_services[name] %}
{% for ctype, local in service.locals %}
        {{ ctype }} {{ local }} = 0U;
{% endfor %}
        ::bswservice::rte::{{ service.read }}({% for ctype, local in service.locals %}{{ local }}{{ ", " if not loop.last }}{% endfor %});
{% endfor %}
{% for b in bsw_inputs if b.io_task is sameas task %}
        {{ b.io_ref }} = {{ bsw_expr[b.name] }};
{% endfor %}
    }
{% endif %}
{% if task.name in mode_switch %}
{{ mode_switch[task.name] }}{% endif %}
}

void writeOutputs{{ suffix }}()
{
{% if can and can_task is sameas task %}
    writeCan();
{% endif %}
{% for b in buffers if b.bsw == "dio.out" and b.io_task is sameas task %}
    (void)::bios::Output::set(::bios::Output::{{ b.bsw_signal }}, ({{ b.io_ref }} != 0U) ? 1U : 0U);
{% endfor %}
{% if sleep_requests and sleep_task is sameas task %}
    // ecu.sleep_request: the ECU may sleep only if every connected component requests it
    ::ecustate::rte::writeSleepRequest(
{% for b in sleep_requests %}
        {{ "(" if loop.first else "&& (" }}{{ b.ref(task) }} != 0U){{ ");" if loop.last else "" }}
{% endfor %}
{% endif %}
{% for b in buffers if b.bsw == "safety.safe_state." and b.io_task is sameas task %}
    // SYS-141: safety.safe_state.{{ b.bsw_name }} - the requested safe state to the selection service, every cycle
    ::safestate::rte::request({{ b.bsw_signal }}, static_cast<uint32_t>({{ b.io_ref }}));
{% endfor %}
{% for b in buffers if b.bsw == "pwm" and b.io_task is sameas task %}
    {
        // pwm.{{ b.bsw_signal }}: written on change only, so the outputs stay masked (inactive level) until the
        // component sets a duty different from its start value; retried while the driver refuses it
        static {{ cpp_types[b.ctype] }} written = {{ b.init }}U;
        if ({{ b.io_ref }} != written)
        {
            uint16_t const duty
                = ({{ b.io_ref }} > {{ pwm_max_duty }}U) ? {{ pwm_max_duty }}U : static_cast<uint16_t>({{ b.io_ref }});
            if (::bios::OutputPwm::setDuty(::bios::OutputPwm::{{ b.bsw_signal }}, duty, false) == ::bsp::BSP_OK)
            {
                written = {{ b.io_ref }};
            }
        }
    }
{% endfor %}
{% set task_ages = age_buffers | selectattr("io_task", "sameas", task) | list %}
{% if task_ages %}
    // SYS-32: age of the supervised provided ports written in this task (deadline: period of the writer)
{% for b in task_ages %}
    {{ b.io_ref }} = ageQualifier({{ b.age.flag }}, ageStates[{{ b.age.index }}], {{ b.age.limit }}U); // {{ b.age.writer }}, {{ b.age.runnable }} every {{ b.age.period_ms }} ms
{% endfor %}
{% endif %}
{% if task.copy_out %}
    {
        // publish the values of this cycle for other tasks
        ::async::LockType const lock;
{% for b in task.copy_out %}
        {{ b.assign(b.name, b.ref(task)) }}
{% endfor %}
    }
{% endif %}
{% set task_nvm = (nvm.blocks | selectattr("task", "sameas", task) | list) if nvm else [] %}
{% if task_nvm %}
    {
        // NVM-02: changed values of the non-volatile blocks written in this task go to the NvM
        ::async::LockType const lock;
{% for blk in task_nvm %}
        nvmHandOver(&{{ blk.buffer.name }}, &{{ blk.image }}, sizeof({{ blk.image }}), nvmChanged[{{ blk.index }}]);
{% endfor %}
    }
{% endif %}
}
} // namespace

{% endfor %}
void readInputs(size_t const task)
{
    switch (task)
    {
{% for task in tasks %}
        case {{ task.index }}U: readInputs_{{ task.name }}(); break;
{% endfor %}
        default: break;
    }
}

void writeOutputs(size_t const task)
{
    switch (task)
    {
{% for task in tasks %}
        case {{ task.index }}U: writeOutputs_{{ task.name }}(); break;
{% endfor %}
        default: break;
    }
}

void init()
{
{% if capture_inputs %}
    // the RTE is the only user of the capture inputs: it starts the counters and arms the first measurement
    ::bios::InputCapture::init();
{% endif %}
{% if hall_inputs or pin_events_project %}
    // the RTE is the only user of the pin interrupts (Hall sensors, pin events): the port arms the pins, starts
    // every consumer from the levels sampled then and enables the vectors - once; its object also holds the
    // interrupt handlers (bsp/pinIrq/PinIrqConfig.h)
    ::bsp::startPinInterrupts();
{% endif %}
{% if can %}
    if (!canStarted)
    {
        startCan(); // CAN start values of the received signals and the E2E states
    }
{% endif %}
{% if shared_buffers %}
    // values written by the init runnables (and CAN start values) to all tasks
    ::async::LockType const lock;
{% for task in tasks %}
{% for b in task.copy_out %}
    {{ b.assign(b.name, b.ref(task)) }}
{% endfor %}
{% endfor %}
{% for task in tasks %}
{% for b in task.copy_in %}
    {{ b.assign(b.ref(task), b.name) }}
{% endfor %}
{% endfor %}
{% endif %}
{% if nvm and nvm.blocks | selectattr("buffer") | list %}
{% if not shared_buffers %}
    ::async::LockType const lock;
{% endif %}
    // NVM-02: values the init runnables wrote to non-volatile blocks go to the NvM
{% for blk in nvm.blocks if blk.buffer %}
    nvmHandOver(&{{ blk.buffer.name }}, &{{ blk.image }}, sizeof({{ blk.image }}), nvmChanged[{{ blk.index }}]);
{% endfor %}
{% endif %}
}
{% if diag_code %}
{{ diag_code }}
{% endif %}
{% if dem_code %}
{{ dem_code }}
{% endif %}

} // namespace rte
