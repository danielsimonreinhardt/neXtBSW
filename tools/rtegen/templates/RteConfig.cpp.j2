// ---- SYS-32: age supervision of provided ports (age.qlf.*, gap G3 of the safety concept) ----
namespace
{
struct AgeState
{
    uint32_t cycles; // cycles of the writer's task since the last write (saturates at the deadline)
    bool written;    // written at least once since the start
};

AgeState ageStates[{{ age_buffers | length }}] = {};

/**
 * Called at the end of every cycle of the writer's task, after its runnables: a write in this cycle (flag of
 * Rte_Write) makes the value fresh; otherwise it ages by one cycle and is stale once it reaches the deadline (the
 * period of the writing runnable in cycles of the task) - also when it was never written since the start.
 */
uint8_t ageQualifier(uint8& flag, AgeState& state, uint32_t const deadline)
{
    if (flag != 0U)
    {
        flag          = 0U;
        state.cycles  = 0U;
        state.written = true;
        return QLF_OK;
    }
    if (state.cycles < deadline)
    {
        ++state.cycles;
    }
    if (state.cycles >= deadline)
    {
        return QLF_ERROR_TIMEOUT;
    }
    return state.written ? QLF_OK : QLF_DEBOUNCE;
}
} // namespace

