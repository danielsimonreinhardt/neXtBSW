::can::ICanTransceiver* canTransceiver = nullptr;
bool canStarted                        = false;
uint32_t canTick                       = 0U;
{% if can_tx %}
/**
 * CommunicationControl (UDS 0x28, COM-29): may the application still send its non-diagnostic messages?
 * Default after a reset: yes. A diagnostic stack switches it off before a programming event
 * (ISO 14229-1 16.3.1.1 step (7)) through setApplicationTxEnabled() and back on when the session ends; the
 * RTE never asks a diagnostic module, so a project without one simply keeps the default. Written in the
 * diagnostic context, read in the CAN task: a single bool, written and read atomically on every target of
 * this project.
 */
bool applicationTxEnabled = true;
{% endif %}
