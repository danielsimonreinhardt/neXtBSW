{% if e2e_rx %}

/** E2E check result of one message as a qualifier value; QLF_DEBOUNCE: no verdict (no new data). */
uint8_t qualifierOf(E2E_PCheckStatusType const status)
{
    switch (status)
    {
        case E2E_P_OK: return QLF_OK;
        case E2E_P_REPEATED:
        case E2E_P_WRONGSEQUENCE: return QLF_ERROR_ALIVE;
        case E2E_P_NONEWDATA: return QLF_DEBOUNCE;
        default: return QLF_ERROR_CRC; // E2E_P_ERROR (checksum or data id), E2E_P_NOTAVAILABLE
    }
}
{% endif %}
{% for e in e2e_rx %}
{% set c = e.e2e %}

// E2E {{ c.profile }} of {{ e.message.name }}: CRC {{ c.crc_signal }} (bit offset {{ c.crc_offset }}), counter {{ c.counter_signal }} ({{ c.counter_offset }}){% if c.nibble_signal %}, data id nibble {{ c.nibble_signal }} ({{ c.nibble_offset }}){% endif %}

{{ c.config_type }} const {{ e.message.name }}_E2E_CONFIG = {{ c.initializer }};
E2E_{{ c.profile }}CheckStateType {{ e.message.name }}_E2E_CHECK;

uint8_t check{{ e.message.name }}(uint8_t const* const data)
{
    E2E_{{ c.profile }}CheckStateType& state = {{ e.message.name }}_E2E_CHECK;
    // Called for received frames only: the counter tolerance of the legacy profiles grows with every call,
    // so calling it in every task cycle would widen it until it accepts any counter. "No new data" is the
    // job of the timeout supervision below.
    E2E_ReturnType const rc
        = E2E_{{ c.profile }}Check(&{{ e.message.name }}_E2E_CONFIG, &state, data, CANDB_{{ e.message.name | upper }}_LENGTH);
    return qualifierOf({{ c.map_call }});
}
