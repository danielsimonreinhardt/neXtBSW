void apply{{ e.message.name }}({{ p }}_t const& msg)
{
{% for l in e.links %}
{% set f = p ~ "_" ~ l.signal.name %}
{% if l.kind == "bool" %}
    {{ l.buffer.ref(can_task) }} = ({{ f }}_ToInt(msg.{{ l.signal.name }}) != 0) ? 1U : 0U;
{% elif l.kind == "int" %}
    {{ l.buffer.ref(can_task) }} = static_cast<{{ l.buffer.ctype }}>({{ f }}_ToInt(msg.{{ l.signal.name }}));
{% else %}
    {{ l.buffer.ref(can_task) }} = static_cast<{{ l.buffer.ctype }}>({{ f }}_ToDouble(msg.{{ l.signal.name }}));
{% endif %}
{% endfor %}
{% if not e.links %}
    (void)msg;
{% endif %}
}
