// ---- CAN ({{ can.dbc.path.name }}, node {{ can.node }}, bus {{ can.bus }}, task {{ can_task.name }}) ----
// Received frames are copied in the CAN task under a lock and unpacked in readInputs(). Due messages are
// packed and written to the transceiver in writeOutputs().
//
// Signal qualifier (COM-03, doc/architecture/signal-qualifier.md): every received message has one qualifier
// (Rte_Qlf.h, RTE target can.qlf.<Message>). It is decided here, not in the component:
//   QLF_ERROR         bus error: transceiver of the bus not open (muted, closed) or bus off; error
//                     passive is not an error (COM-12). Highest precedence.
//   QLF_ERROR_TIMEOUT no frame within timeoutMs
//   QLF_ERROR_CRC     E2E checksum or data id wrong for longer than debounceMs
//   QLF_ERROR_ALIVE   E2E counter repeated or out of sequence for longer than debounceMs
//   QLF_OK            a valid message arrived and nothing is pending (healing after one valid message)
//   QLF_DEBOUNCE      nothing valid yet, or an E2E error still inside debounceMs
// Signal values are taken over from valid messages only. While an error is reported, on_error decides:
// hold keeps the last valid values, init writes the DBC start values (GenSigStartValue).

CanRxStatus CAN_RX_STATUS[{{ [can_rx | length, 1] | max }}] = {
{% for e in can_rx %}
    {"{{ e.message.name }}", CANDB_{{ e.message.name | upper }}_ID, {{ e.ticks * can_task.period_ms }}U, {{ e.qlf.debounce_ms }}U, 0U, 0U, 0U, 0U, 0U, 0U, 0U, QLF_DEBOUNCE, 0U, false, false, {{ "true" if e.qlf.on_error == "init" else "false" }}},
{% endfor %}
};

CanTxStatus CAN_TX_STATUS[{{ [can_tx | length, 1] | max }}] = {
{% for e in can_tx %}
    {"{{ e.message.name }}", CANDB_{{ e.message.name | upper }}_ID, {{ e.message.cycle_ms }}U, 0U, 0U, 0U},
{% endfor %}
};

namespace
{
{% if can_rx %}
constexpr uint32_t CAN_ID_MASK = ::can::CanId::EXTENDED_QUALIFIER_BIT | ::can::CanId::MAX_RAW_EXTENDED_ID;

struct RxSlot
{
    uint8_t data[8];
    bool pending;
};

uint8_t const RX_LENGTH[{{ can_rx | length }}] = {
{% for e in can_rx %}
    CANDB_{{ e.message.name | upper }}_LENGTH,
{% endfor %}
};

RxSlot rxSlots[{{ can_rx | length }}];

size_t rxIndex(uint32_t const id)
{
    uint32_t const masked = id & CAN_ID_MASK;
    for (size_t i = 0U; i < CAN_RX_COUNT; ++i)
    {
        if (CAN_RX_STATUS[i].id == masked)
        {
            return i;
        }
    }
    return CAN_RX_COUNT;
}

class RxListener final : public ::can::ICANFrameListener
{
public:
    RxListener() : _filter() {}

    void frameReceived(::can::CANFrame const& frame) override
    {
        size_t const index = rxIndex(frame.getId());
        if (index < CAN_RX_COUNT)
        {
            uint8_t const* const payload = frame.getPayload();
            ::async::LockType const lock;
            if (frame.getPayloadLength() < RX_LENGTH[index])
            {
                ++CAN_RX_STATUS[index].lengthErrors;
            }
            else
            {
                for (uint8_t i = 0U; i < RX_LENGTH[index]; ++i)
                {
                    rxSlots[index].data[i] = payload[i];
                }
                rxSlots[index].pending = true;
                ++CAN_RX_STATUS[index].received;
            }
        }
    }

    ::can::IFilter& getFilter() override { return _filter; }

private:
    // Standard IDs are merged into the transceiver's hardware filter, match() also covers extended IDs.
    class Filter final : public ::can::BitFieldFilter
    {
    public:
        Filter()
        {
            for (size_t i = 0U; i < CAN_RX_COUNT; ++i)
            {
                if (!::can::CanId::isExtended(CAN_RX_STATUS[i].id))
                {
                    add(CAN_RX_STATUS[i].id);
                }
            }
        }

        bool match(uint32_t const id) const override { return rxIndex(id) < CAN_RX_COUNT; }
    };

    Filter _filter;
};

RxListener rxListener;

bool takeRx(size_t const index, uint8_t data[])
{
    ::async::LockType const lock;
    bool const pending = rxSlots[index].pending;
    if (pending)
    {
        for (uint8_t i = 0U; i < RX_LENGTH[index]; ++i)
        {
            data[i] = rxSlots[index].data[i];
        }
        rxSlots[index].pending = false;
    }
    return pending;
}
