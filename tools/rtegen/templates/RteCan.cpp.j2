uint32_t addSaturating(uint32_t const value, uint32_t const step)
{
    return ((UINT32_MAX - value) < step) ? UINT32_MAX : (value + step);
}

/**
 * Timeout supervision and qualifier of one received message. fresh: a frame of the right length arrived in
 * this cycle, verdict: its E2E result (QLF_DEBOUNCE without E2E or without a frame).
 */
void superviseRx(
    size_t const index, bool const fresh, uint8_t const verdict, bool const busError, void (*const applyStart)())
{
    CanRxStatus& s = CAN_RX_STATUS[index];
    if (fresh)
    {
        s.ageMs    = 0U;
        s.timedOut = false;
    }
    else
    {
        s.ageMs = addSaturating(s.ageMs, CAN_PERIOD_MS);
        if ((s.timeoutMs != 0U) && !s.timedOut && (s.ageMs >= s.timeoutMs))
        {
            s.timedOut = true;
            ++s.timeouts;
        }
    }
    if (fresh && (verdict == QLF_OK))
    {
        // valid message: healing (QLF_OK again after one valid message)
        s.valid      = true;
        s.errorFlags = 0U;
        s.errorMs    = 0U;
    }
    else
    {
        if (s.errorFlags != 0U)
        {
            s.errorMs = addSaturating(s.errorMs, CAN_PERIOD_MS);
        }
        if ((verdict == QLF_ERROR_CRC) || (verdict == QLF_ERROR_ALIVE))
        {
            if (s.errorFlags == 0U)
            {
                s.errorMs = 0U; // first error after a valid message: debounce starts now
            }
            s.errorFlags = static_cast<uint8_t>(s.errorFlags | verdict);
            if (verdict == QLF_ERROR_CRC)
            {
                ++s.crcErrors;
            }
            else
            {
                ++s.aliveErrors;
            }
        }
    }

    uint8_t qualifier;
    if (busError)
    {
        qualifier = QLF_ERROR;
    }
    else if (s.timedOut)
    {
        qualifier = QLF_ERROR_TIMEOUT;
    }
    else if ((s.errorFlags != 0U) && (s.errorMs >= s.debounceMs))
    {
        // both kinds seen while debouncing: the checksum has precedence over the counter
        qualifier = ((s.errorFlags & QLF_ERROR_CRC) != 0U) ? QLF_ERROR_CRC : QLF_ERROR_ALIVE;
    }
    else
    {
        qualifier = ((s.errorFlags == 0U) && s.valid) ? QLF_OK : QLF_DEBOUNCE;
    }
    if (s.startOnError && (qualifier > QLF_OK) && (s.qlf <= QLF_OK))
    {
        applyStart(); // on_error: init - the signals take the DBC start values while the error lasts
    }
    s.qlf = qualifier;
}
