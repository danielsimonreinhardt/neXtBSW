void e2eInit()
{
{% for e in e2e_rx %}
    (void)E2E_{{ e.e2e.profile }}CheckInit(&{{ e.message.name }}_E2E_CHECK);
{% endfor %}
{% for e in e2e_tx %}
    (void)E2E_{{ e.e2e.profile }}ProtectInit(&{{ e.message.name }}_E2E_PROTECT);
{% endfor %}
}
{% endif %}

void startCan()
{
{% if can_rx %}
    applyStartValues();
{% endif %}
{% if e2e_rx or e2e_tx %}
    e2eInit();
{% endif %}
{% if tx_events %}
    txEventInit();
{% endif %}
    canStarted = true;
}
{% if can_rx %}

/** Bus error for every received message of the bus: transceiver not open (muted, closed) or bus off. */
bool canBusError()
{
    // Before the RTE is attached (CAN comes up in an earlier lifecycle level) nothing is known about the
    // bus: the messages stay QLF_DEBOUNCE, as after a reset.
    if (canTransceiver == nullptr)
    {
        return false;
    }
    // Not open: muted because the transceiver part is not ready, or closed (CanPhyGate).
    if (canTransceiver->getState() != ::can::ICanTransceiver::State::OPEN)
    {
        return true;
    }
    // Bus off only. PASSIVE (error passive) is not a bus error: the bus still works, and a node alone
    // on its bus reaches that state regularly - reporting it would hide timeout, checksum and counter
    // states again, exactly the effect the COM-03 board test showed (COM-12).
    return canTransceiver->getCANTransceiverState()
           == ::can::ICANTransceiverStateListener::CANTransceiverState::BUS_OFF;
}
{% endif %}

void readCan()
{
    if (!canStarted)
    {
        startCan();
    }
    if (canTransceiver == nullptr)
    {
        ::can::ICanTransceiver* const transceiver = ::systems::getCanSystem().getCanTransceiver(::busid::{{ can.bus_ident }});
        if (transceiver != nullptr)
        {
{% if can_rx %}
            transceiver->addCANFrameListener(rxListener);
{% endif %}
            canTransceiver = transceiver;
        }
    }
{% if can_rx %}
    bool const busError = canBusError();
{% endif %}
{% for e in can_rx %}
    {
        uint8_t data[8];
        bool const fresh = takeRx({{ e.index }}U, data);
{% if e.e2e %}
        uint8_t const verdict = fresh ? check{{ e.message.name }}(data) : QLF_DEBOUNCE;
{% else %}
        uint8_t const verdict = fresh ? QLF_OK : QLF_DEBOUNCE; // no E2E: every frame of the right length counts
{% endif %}
        if (fresh && (verdict == QLF_OK))
        {
            CanDb_{{ e.message.name }}_t msg;
            CanDb_{{ e.message.name }}_Unpack(&msg, data);
            apply{{ e.message.name }}(msg);
        }
        superviseRx({{ e.index }}U, fresh, verdict, busError, &startValue{{ e.message.name }});
        {{ e.qlf_buffer.ref(can_task) }} = CAN_RX_STATUS[{{ e.index }}].qlf; // can.qlf.{{ e.message.name }}
    }
{% endfor %}
}

void writeCan()
{
{% if can_tx %}
    // canTick keeps running while the transmission is off: the messages come back in their own phase, and
    // the E2E counter continues where it stopped, so the receiver sees no gap in the sequence.
    if ((canTransceiver != nullptr) && (canTransceiver->getState() == ::can::ICanTransceiver::State::OPEN)
        && applicationTxEnabled)
{% else %}
    if ((canTransceiver != nullptr) && (canTransceiver->getState() == ::can::ICanTransceiver::State::OPEN))
{% endif %}
    {
{% for e in can_tx %}
{% set p = "CanDb_" ~ e.message.name %}
{% if e.on_change %}
        {
            // {{ e.message.name }}: GenMsgSendType {{ e.message.send_type }} - on change{% if e.send_mode == "mixed" %} and every {{ e.message.cycle_ms }} ms{% endif %}, minimum gap {{ e.message.delay_ms }} ms (COM-38)
            {{ p }}_t msg;
            {{ p }}_Init(&msg);
{% for l in e.links %}
{% set f = p ~ "_" ~ l.signal.name %}
{% if l.kind == "bool" %}
            msg.{{ l.signal.name }} = {{ f }}_FromInt(({{ l.buffer.ref(can_task) }} != 0U) ? 1 : 0);
{% elif l.kind == "int" %}
            msg.{{ l.signal.name }} = {{ f }}_FromInt(static_cast<int64_t>({{ l.buffer.ref(can_task) }}));
{% else %}
            msg.{{ l.signal.name }} = {{ f }}_FromDouble(static_cast<double>({{ l.buffer.ref(can_task) }}));
{% endif %}
{% endfor %}
            uint8_t data[8] = {0U};
            {{ p }}_Pack(&msg, data);
            TxEvent& event = txEvents[{{ e.event_index }}U];
{% if e.send_mode == "mixed" %}
            if ((canTick % {{ e.ticks }}U) == 0U)
            {
                event.cyclicPending = true;
            }
{% endif %}
            bool const changed = (std::memcmp(data, event.last, sizeof(data)) != 0);
{% if e.delay_ticks > 0 %}
            if ((changed || event.cyclicPending) && (event.sinceLast >= {{ e.delay_ticks }}U))
{% else %}
            if (changed || event.cyclicPending)
{% endif %}
            {
                uint8_t plain[8];
                (void)std::memcpy(plain, data, sizeof(plain)); // the signal values, before E2E
                event.sinceLast     = 0U;
                event.cyclicPending = false;
{% if e.e2e %}
                // E2E after packing: counter and CRC overwrite their signal positions
                if (E2E_{{ e.e2e.profile }}Protect(
                        &{{ e.message.name }}_E2E_CONFIG,
                        &{{ e.message.name }}_E2E_PROTECT,
                        data,
                        CANDB_{{ e.message.name | upper }}_LENGTH)
                    != E2E_E_OK)
                {
                    ++CAN_TX_STATUS[{{ e.index }}].protectErrors;
                }
{% endif %}
                ::can::CANFrame const frame(CANDB_{{ e.message.name | upper }}_ID, data, CANDB_{{ e.message.name | upper }}_LENGTH);
                if (canTransceiver->write(frame) == ::can::ICanTransceiver::ErrorCode::CAN_ERR_OK)
                {
                    ++CAN_TX_STATUS[{{ e.index }}].sent;
                    (void)std::memcpy(event.last, plain, sizeof(plain));
                }
                else
                {
                    ++CAN_TX_STATUS[{{ e.index }}].failed; // the change stays pending
                }
            }
        }
{% else %}
        if ((canTick % {{ e.ticks }}U) == 0U)
        {
            {{ p }}_t msg;
            {{ p }}_Init(&msg);
{% for l in e.links %}
{% set f = p ~ "_" ~ l.signal.name %}
{% if l.kind == "bool" %}
            msg.{{ l.signal.name }} = {{ f }}_FromInt(({{ l.buffer.ref(can_task) }} != 0U) ? 1 : 0);
{% elif l.kind == "int" %}
            msg.{{ l.signal.name }} = {{ f }}_FromInt(static_cast<int64_t>({{ l.buffer.ref(can_task) }}));
{% else %}
            msg.{{ l.signal.name }} = {{ f }}_FromDouble(static_cast<double>({{ l.buffer.ref(can_task) }}));
{% endif %}
{% endfor %}
            uint8_t data[8] = {0U};
            {{ p }}_Pack(&msg, data);
{% if e.e2e %}
            // E2E after packing: counter and CRC overwrite their signal positions
            if (E2E_{{ e.e2e.profile }}Protect(
                    &{{ e.message.name }}_E2E_CONFIG,
                    &{{ e.message.name }}_E2E_PROTECT,
                    data,
                    CANDB_{{ e.message.name | upper }}_LENGTH)
                != E2E_E_OK)
            {
                ++CAN_TX_STATUS[{{ e.index }}].protectErrors;
            }
{% endif %}
            ::can::CANFrame const frame(CANDB_{{ e.message.name | upper }}_ID, data, CANDB_{{ e.message.name | upper }}_LENGTH);
            if (canTransceiver->write(frame) == ::can::ICanTransceiver::ErrorCode::CAN_ERR_OK)
            {
                ++CAN_TX_STATUS[{{ e.index }}].sent;
            }
            else
            {
                ++CAN_TX_STATUS[{{ e.index }}].failed;
            }
        }
{% endif %}
{% endfor %}
    }
{% if tx_events %}
    for (TxEvent& event : txEvents)
    {
        if (event.sinceLast < 0xFFFFFFFFU)
        {
            ++event.sinceLast;
        }
    }
{% endif %}
    ++canTick;
}
} // namespace
{% if can_tx %}

void setApplicationTxEnabled(bool const enabled) { applicationTxEnabled = enabled; }
{% endif %}

bool isCanAttached() { return canTransceiver != nullptr; }

char const* canBusStateName()
{
    if (canTransceiver == nullptr)
    {
        return "not attached";
    }
    switch (canTransceiver->getState())
    {
        case ::can::ICanTransceiver::State::CLOSED: return "closed";
        case ::can::ICanTransceiver::State::INITIALIZED: return "initialized";
        case ::can::ICanTransceiver::State::WAKING: return "waking";
        case ::can::ICanTransceiver::State::MUTED: return "muted (phy not ready)";
        default: break; // OPEN: the state of the bus itself decides
    }
    switch (canTransceiver->getCANTransceiverState())
    {
        case ::can::ICANTransceiverStateListener::CANTransceiverState::BUS_OFF: return "bus off";
        case ::can::ICANTransceiverStateListener::CANTransceiverState::PASSIVE: return "error passive";
        default: return "error active";
    }
}
