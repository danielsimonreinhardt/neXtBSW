{% if tx_events %}

/**
 * Event and mixed messages (COM-38, GenMsgSendType of the DBC): a message goes out when its packed signal
 * values differ from the last sent ones, a mixed message also in its cycle. The comparison is made before the
 * E2E protection, so counter and CRC are no change; the counter advances with every frame that is sent, event
 * or cyclic. GenMsgDelayTime is the minimum gap between two sends: a change inside it waits and goes out
 * with the value it has then, so a port that is written fast does not flood the bus. After the start the DBC
 * start values count as sent; a refused write keeps the change pending.
 */
struct TxEvent
{
    uint8_t last[8];    // payload of the last send (start: the DBC start values), before E2E
    uint32_t sinceLast; // CAN task cycles since the last send, saturating
    bool cyclicPending; // mixed message: its cycle is due, held back by the minimum gap
};

TxEvent txEvents[{{ tx_events | length }}];

void txEventInit()
{
{% for e in tx_events %}
    {
        CanDb_{{ e.message.name }}_t msg;
        CanDb_{{ e.message.name }}_Init(&msg);
        TxEvent& event = txEvents[{{ e.event_index }}U];
        (void)std::memset(event.last, 0, sizeof(event.last));
        CanDb_{{ e.message.name }}_Pack(&msg, event.last);
        event.sinceLast     = 0xFFFFFFFFU;
        event.cyclicPending = false;
    }
{% endfor %}
}
{% endif %}
