<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-License-Identifier: Apache-2.0
Synthetic XML Component Description for SensorSwc (tools/rtegen IO-18 host test, written by hand in the style of the
Embedded Coder export): required ports for signed physical ADC values (sint32) and their qualifiers (uint8), one
periodic runnable without access points (it reads every port).
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00051.xsd">
