<?xml version="1.0" encoding="UTF-8"?>
<!--
Synthetic XML Component Description for NvmSwc (tools/rtegen NVM-02 host test, non-volatile blocks), written in the
style of the Embedded Coder export: one file with component, interfaces and data types, no access points (every
runnable may access every port). Boot counter: Init reads StoredCount (nvm.BootCount) and writes Count + 1 to the same
block; trim value: Run10ms reads Trim (nvm.Trim) and writes TrimOut on request of the test.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00051.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>Components</SHORT-NAME>
            <ELEMENTS>
                <APPLICATION-SW-COMPONENT-TYPE>
                    <SHORT-NAME>NvmSwc</SHORT-NAME>
                    <PORTS>
                        <R-PORT-PROTOTYPE>
                            <SHORT-NAME>StoredCount</SHORT-NAME>
                            <REQUIRED-COM-SPECS>
                                <NONQUEUED-RECEIVER-COM-SPEC>
                                    <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/StoredCount/StoredCount</DATA-ELEMENT-REF>
                                    <INIT-VALUE>
                                        <NUMERICAL-VALUE-SPECIFICATION>
                                            <VALUE>0</VALUE>
                                        </NUMERICAL-VALUE-SPECIFICATION>
                                    </INIT-VALUE>
                                </NONQUEUED-RECEIVER-COM-SPEC>
                            </REQUIRED-COM-SPECS>
                            <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/StoredCount</REQUIRED-INTERFACE-TREF>
                        </R-PORT-PROTOTYPE>
                        <P-PORT-PROTOTYPE>
                            <SHORT-NAME>Count</SHORT-NAME>
                            <PROVIDED-COM-SPECS>
                                <NONQUEUED-SENDER-COM-SPEC>
                                    <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/Count/Count</DATA-ELEMENT-REF>
                                    <INIT-VALUE>
                                        <NUMERICAL-VALUE-SPECIFICATION>
                                            <VALUE>0</VALUE>
                                        </NUMERICAL-VALUE-SPECIFICATION>
                                    </INIT-VALUE>
                                </NONQUEUED-SENDER-COM-SPEC>
                            </PROVIDED-COM-SPECS>
                            <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/Count</PROVIDED-INTERFACE-TREF>
                        </P-PORT-PROTOTYPE>
                        <R-PORT-PROTOTYPE>
                            <SHORT-NAME>Trim</SHORT-NAME>
                            <REQUIRED-COM-SPECS>
                                <NONQUEUED-RECEIVER-COM-SPEC>
                                    <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/Trim/Trim</DATA-ELEMENT-REF>
                                    <INIT-VALUE>
                                        <NUMERICAL-VALUE-SPECIFICATION>
                                            <VALUE>500</VALUE>
                                        </NUMERICAL-VALUE-SPECIFICATION>
                                    </INIT-VALUE>
                                </NONQUEUED-RECEIVER-COM-SPEC>
                            </REQUIRED-COM-SPECS>
                            <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/Trim</REQUIRED-INTERFACE-TREF>
                        </R-PORT-PROTOTYPE>
                        <P-PORT-PROTOTYPE>
                            <SHORT-NAME>TrimOut</SHORT-NAME>
                            <PROVIDED-COM-SPECS>
                                <NONQUEUED-SENDER-COM-SPEC>
                                    <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/TrimOut/TrimOut</DATA-ELEMENT-REF>
                                    <INIT-VALUE>
                                        <NUMERICAL-VALUE-SPECIFICATION>
                                            <VALUE>500</VALUE>
                                        </NUMERICAL-VALUE-SPECIFICATION>
                                    </INIT-VALUE>
                                </NONQUEUED-SENDER-COM-SPEC>
                            </PROVIDED-COM-SPECS>
                            <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/TrimOut</PROVIDED-INTERFACE-TREF>
                        </P-PORT-PROTOTYPE>
                        <R-PORT-PROTOTYPE>
                            <SHORT-NAME>WideTrim</SHORT-NAME>
                            <REQUIRED-COM-SPECS>
                                <NONQUEUED-RECEIVER-COM-SPEC>
                                    <DATA-ELEMENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/WideTrim/WideTrim</DATA-ELEMENT-REF>
                                    <INIT-VALUE>
                                        <NUMERICAL-VALUE-SPECIFICATION>
                                            <VALUE>0</VALUE>
                                        </NUMERICAL-VALUE-SPECIFICATION>
                                    </INIT-VALUE>
                                </NONQUEUED-RECEIVER-COM-SPEC>
                            </REQUIRED-COM-SPECS>
                            <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/WideTrim</REQUIRED-INTERFACE-TREF>
                        </R-PORT-PROTOTYPE>
                    </PORTS>
                    <INTERNAL-BEHAVIORS>
                        <SWC-INTERNAL-BEHAVIOR>
                            <SHORT-NAME>NvmSwc_IB</SHORT-NAME>
                            <EVENTS>
                                <INIT-EVENT>
                                    <SHORT-NAME>Event_Init</SHORT-NAME>
                                    <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/NvmSwc/NvmSwc_IB/Init</START-ON-EVENT-REF>
                                </INIT-EVENT>
                                <TIMING-EVENT>
                                    <SHORT-NAME>Event_Run10ms</SHORT-NAME>
                                    <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/NvmSwc/NvmSwc_IB/Run10ms</START-ON-EVENT-REF>
                                    <PERIOD>0.01</PERIOD>
                                </TIMING-EVENT>
                            </EVENTS>
                            <RUNNABLES>
                                <RUNNABLE-ENTITY>
                                    <SHORT-NAME>Init</SHORT-NAME>
                                    <SYMBOL>NvmSwc_Init</SYMBOL>
                                </RUNNABLE-ENTITY>
                                <RUNNABLE-ENTITY>
                                    <SHORT-NAME>Run10ms</SHORT-NAME>
                                    <SYMBOL>NvmSwc_Run10ms</SYMBOL>
                                </RUNNABLE-ENTITY>
                            </RUNNABLES>
                        </SWC-INTERNAL-BEHAVIOR>
                    </INTERNAL-BEHAVIORS>
                </APPLICATION-SW-COMPONENT-TYPE>
            </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
            <SHORT-NAME>Interfaces</SHORT-NAME>
            <ELEMENTS>
                <SENDER-RECEIVER-INTERFACE>
                    <SHORT-NAME>StoredCount</SHORT-NAME>
                    <IS-SERVICE>false</IS-SERVICE>
                    <DATA-ELEMENTS>
                        <VARIABLE-DATA-PROTOTYPE>
                            <SHORT-NAME>StoredCount</SHORT-NAME>
                            <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/uint32</TYPE-TREF>
                        </VARIABLE-DATA-PROTOTYPE>
                    </DATA-ELEMENTS>
                </SENDER-RECEIVER-INTERFACE>
                <SENDER-RECEIVER-INTERFACE>
                    <SHORT-NAME>Count</SHORT-NAME>
                    <IS-SERVICE>false</IS-SERVICE>
                    <DATA-ELEMENTS>
                        <VARIABLE-DATA-PROTOTYPE>
                            <SHORT-NAME>Count</SHORT-NAME>
                            <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/uint32</TYPE-TREF>
                        </VARIABLE-DATA-PROTOTYPE>
                    </DATA-ELEMENTS>
                </SENDER-RECEIVER-INTERFACE>
                <SENDER-RECEIVER-INTERFACE>
                    <SHORT-NAME>Trim</SHORT-NAME>
                    <IS-SERVICE>false</IS-SERVICE>
                    <DATA-ELEMENTS>
                        <VARIABLE-DATA-PROTOTYPE>
                            <SHORT-NAME>Trim</SHORT-NAME>
                            <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/uint16</TYPE-TREF>
                        </VARIABLE-DATA-PROTOTYPE>
                    </DATA-ELEMENTS>
                </SENDER-RECEIVER-INTERFACE>
                <SENDER-RECEIVER-INTERFACE>
                    <SHORT-NAME>TrimOut</SHORT-NAME>
                    <IS-SERVICE>false</IS-SERVICE>
                    <DATA-ELEMENTS>
                        <VARIABLE-DATA-PROTOTYPE>
                            <SHORT-NAME>TrimOut</SHORT-NAME>
                            <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/uint16</TYPE-TREF>
                        </VARIABLE-DATA-PROTOTYPE>
                    </DATA-ELEMENTS>
                </SENDER-RECEIVER-INTERFACE>
                <SENDER-RECEIVER-INTERFACE>
                    <SHORT-NAME>WideTrim</SHORT-NAME>
                    <IS-SERVICE>false</IS-SERVICE>
                    <DATA-ELEMENTS>
                        <VARIABLE-DATA-PROTOTYPE>
                            <SHORT-NAME>WideTrim</SHORT-NAME>
                            <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/DataTypes/uint32</TYPE-TREF>
                        </VARIABLE-DATA-PROTOTYPE>
                    </DATA-ELEMENTS>
                </SENDER-RECEIVER-INTERFACE>
            </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
            <SHORT-NAME>DataTypes</SHORT-NAME>
            <ELEMENTS>
                <IMPLEMENTATION-DATA-TYPE>
                    <SHORT-NAME>uint16</SHORT-NAME>
                    <CATEGORY>VALUE</CATEGORY>
                    <SW-DATA-DEF-PROPS>
                        <SW-DATA-DEF-PROPS-VARIANTS>
                            <SW-DATA-DEF-PROPS-CONDITIONAL>
                                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/DataTypes/SwBaseTypes/uint16</BASE-TYPE-REF>
                            </SW-DATA-DEF-PROPS-CONDITIONAL>
                        </SW-DATA-DEF-PROPS-VARIANTS>
                    </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
                <IMPLEMENTATION-DATA-TYPE>
                    <SHORT-NAME>uint32</SHORT-NAME>
                    <CATEGORY>VALUE</CATEGORY>
                    <SW-DATA-DEF-PROPS>
                        <SW-DATA-DEF-PROPS-VARIANTS>
                            <SW-DATA-DEF-PROPS-CONDITIONAL>
                                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/DataTypes/SwBaseTypes/uint32</BASE-TYPE-REF>
                            </SW-DATA-DEF-PROPS-CONDITIONAL>
                        </SW-DATA-DEF-PROPS-VARIANTS>
                    </SW-DATA-DEF-PROPS>
                </IMPLEMENTATION-DATA-TYPE>
            </ELEMENTS>
            <AR-PACKAGES>
                <AR-PACKAGE>
                    <SHORT-NAME>SwBaseTypes</SHORT-NAME>
                    <ELEMENTS>
                        <SW-BASE-TYPE>
                            <SHORT-NAME>uint16</SHORT-NAME>
                            <NATIVE-DECLARATION>uint16</NATIVE-DECLARATION>
                        </SW-BASE-TYPE>
                        <SW-BASE-TYPE>
                            <SHORT-NAME>uint32</SHORT-NAME>
                            <NATIVE-DECLARATION>uint32</NATIVE-DECLARATION>
                        </SW-BASE-TYPE>
                    </ELEMENTS>
                </AR-PACKAGE>
            </AR-PACKAGES>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>
