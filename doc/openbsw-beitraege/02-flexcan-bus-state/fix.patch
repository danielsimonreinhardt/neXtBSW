+            cpp2can
+            etl
+            gmock
+            gtest_main)
+
+gtest_discover_tests(FlexCANDeviceTest PROPERTIES LABELS "FlexCANDeviceTest")
diff --git a/platforms/s32k1xx/bsp/bspFlexCan/test/include/mcu/mcu.h b/platforms/s32k1xx/bsp/bspFlexCan/test/include/mcu/mcu.h
new file mode 100644
index 00000000..272b982c
--- /dev/null
+++ b/platforms/s32k1xx/bsp/bspFlexCan/test/include/mcu/mcu.h
@@ -0,0 +1,19 @@
