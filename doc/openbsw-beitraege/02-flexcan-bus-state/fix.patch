+// Test-only mcu.h: the FlexCAN driver needs the FlexCAN register layout and the volatile typedefs
+// of the device header, but not the Cortex-M core header, which cannot be compiled for the host.
+#pragma once
+
+#include "3rdparty/nxp/S32K148_FLEXCAN.h"
+
+typedef uint8_t volatile vuint8_t;
+typedef uint16_t volatile vuint16_t;
+typedef uint32_t volatile vuint32_t;
diff --git a/platforms/s32k1xx/bsp/bspFlexCan/test/src/can/FlexCANDeviceTest.cpp b/platforms/s32k1xx/bsp/bspFlexCan/test/src/can/FlexCANDeviceTest.cpp
new file mode 100644
index 00000000..aa974c12
--- /dev/null
+++ b/platforms/s32k1xx/bsp/bspFlexCan/test/src/can/FlexCANDeviceTest.cpp
@@ -0,0 +1,159 @@
+/********************************************************************************
+ * Copyright (c) 2026 Your Name
+ *
+ * This program and the accompanying materials are made available under the
+ * terms of the Apache License Version 2.0 which is available at
+ * https://www.apache.org/licenses/LICENSE-2.0
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ********************************************************************************/
+
+// The system headers come first: the device header defines __I, which the intrinsics headers
+// pulled in by windows.h use as a parameter name.
+#if defined(_WIN32)
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#endif
+
+#include "can/FlexCANDevice.h"
+
+#include <gtest/gtest.h>
+
+#include <cstring>
+
+namespace
+{
+using ::bios::CanPhyDummy;
+using ::bios::FlexCANDevice;
+
+// FlexCANDevice takes the peripheral base address from its configuration and derives the instance
+// index from it, so the test provides host memory at the base address of FlexCAN_0.
+uint32_t const FLEXCAN_0_BASE = 0x40024000U;
+
+// Stub instead of a mock: the tests below only read status registers, no expectations needed.
+class PowerStateControllerStub : public ::bios::IEcuPowerStateController
+{
+public:
+    void startPreSleep() override {}
+
+    uint32_t powerDown(uint8_t /*mode*/, tCheckWakeupDelegate /*delegate*/) override { return 0U; }
+
+    uint32_t powerDown(uint8_t /*mode*/) override { return 0U; }
+
+    void fullPowerUp() override {}
+
+    void setWakeupSourceMonitoring(
+        uint32_t /*source*/, bool /*active*/, bool /*fallingEdge*/) override
+    {}
+
+    void clearWakeupSourceMonitoring(uint32_t /*source*/) override {}
+
+    bool setWakeupDelegate(tCheckWakeupDelegate& /*delegate*/) override { return true; }
+
+    uint32_t getWakeupSource() override { return 0U; }
+};
+
+bool reserveRegisterBlock()
+{
+    static bool reserved = false;
+    if (reserved)
+    {
+        return true;
+    }
+#if defined(_WIN32)
+    void* const p = VirtualAlloc(
+        reinterpret_cast<void*>(static_cast<uintptr_t>(FLEXCAN_0_BASE) & ~0xFFFFU),
+        0x10000,
+        MEM_RESERVE | MEM_COMMIT,
+        PAGE_READWRITE);
+    reserved = (p != nullptr);
+#else
+    void* const p = mmap(
+        reinterpret_cast<void*>(static_cast<uintptr_t>(FLEXCAN_0_BASE) & ~0xFFFU),
+        0x2000,
+        PROT_READ | PROT_WRITE,
+        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE,
+        -1,
+        0);
+    reserved = (p != MAP_FAILED);
+#endif
+    return reserved;
+}
+
+class FlexCANDeviceTest : public ::testing::Test
+{
+protected:
+    void SetUp() override
+    {
+        if (!reserveRegisterBlock())
+        {
+            GTEST_SKIP() << "cannot map host memory at the FlexCAN base address";
+        }
+        memset(&registers(), 0, sizeof(FLEXCAN_Type));
+        fpDevice = new FlexCANDevice(fConfig, CanPhyDummy::getInstance(), fPowerManager);
+    }
+
+    void TearDown() override { delete fpDevice; }
+
+    static FLEXCAN_Type& registers()
+    {
+        return *reinterpret_cast<FLEXCAN_Type*>(static_cast<uintptr_t>(FLEXCAN_0_BASE));
+    }
+
+    FlexCANDevice::Config fConfig{FLEXCAN_0_BASE, 500000U, 0U, 0U, 0U, 8U, 0U, 8U, 0U, 0U};
+    PowerStateControllerStub fPowerManager;
+    FlexCANDevice* fpDevice = nullptr;
+};
+
+// Values measured on an S32K1xx board while the bus was healthy: ERRINT (bit 1) and IDLE (bit 7)
+// are set, the fault confinement field in bits 4..5 is 0 (error active).
+uint32_t const ESR1_ERROR_ACTIVE_AFTER_ERROR_FRAME = 0x00240082U;
+
+TEST_F(FlexCANDeviceTest, BusIsOnWhileFaultConfinementIsErrorActive)
+{
+    registers().ESR1 = ESR1_ERROR_ACTIVE_AFTER_ERROR_FRAME;
+    EXPECT_EQ(FlexCANDevice::BUS_ON, fpDevice->getBusOffState());
+
+    registers().ESR1 = 0U;
+    EXPECT_EQ(FlexCANDevice::BUS_ON, fpDevice->getBusOffState());
+}
+
+TEST_F(FlexCANDeviceTest, BusIsOnWhileFaultConfinementIsErrorPassive)
+{
+    registers().ESR1 = FLEXCAN_ESR1_FLTCONF(1U);
+    EXPECT_EQ(FlexCANDevice::BUS_ON, fpDevice->getBusOffState());
+}
+
+TEST_F(FlexCANDeviceTest, BusIsOffWhileFaultConfinementIsBusOff)
+{
+    registers().ESR1 = FLEXCAN_ESR1_FLTCONF(2U);
+    EXPECT_EQ(FlexCANDevice::BUS_OFF, fpDevice->getBusOffState());
+}
+
+TEST_F(FlexCANDeviceTest, BusOffStateIsStickyUntilTheDeviceIsRestarted)
+{
+    registers().ESR1 = FLEXCAN_ESR1_FLTCONF(3U);
+    EXPECT_EQ(FlexCANDevice::BUS_OFF, fpDevice->getBusOffState());
+
+    registers().ESR1 = 0U;
+    EXPECT_EQ(FlexCANDevice::BUS_OFF, fpDevice->getBusOffState());
+}
+
+TEST_F(FlexCANDeviceTest, ErrorCountersAreReadAsFields)
+{
+    // ECR: TXERRCNT in bits 0..7, RXERRCNT in bits 8..15
+    registers().ECR = FLEXCAN_ECR_TXERRCNT(30U) | FLEXCAN_ECR_RXERRCNT(0U);
+    EXPECT_EQ(30U, fpDevice->getTxErrorCounter());
+    EXPECT_EQ(0U, fpDevice->getRxErrorCounter());
+
+    registers().ECR = FLEXCAN_ECR_TXERRCNT(128U) | FLEXCAN_ECR_RXERRCNT(96U);
+    EXPECT_EQ(128U, fpDevice->getTxErrorCounter());
+    EXPECT_EQ(96U, fpDevice->getRxErrorCounter());
+
+    registers().ECR = 0xFFFFFFFFU;
+    EXPECT_EQ(255U, fpDevice->getTxErrorCounter());
+    EXPECT_EQ(255U, fpDevice->getRxErrorCounter());
+}
+
+} // anonymous namespace
