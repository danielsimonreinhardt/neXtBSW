+// Test-only hardware fake: the register layout comes from the device header, the peripheral
+// instance is redirected to host memory before mpu.h is included.
+#include "S32K148_MPU.h"
+
+#include <cstring>
+
+namespace
+{
+MPU_Type fakeMpu;
+}
+
+#undef IP_MPU
+#define IP_MPU (&fakeMpu)
+
+#include "safeMemory/mpu.h"
+
+#include <gtest/gtest.h>
+
+namespace
+{
+using namespace ::safety;
+
+class MpuTest : public ::testing::Test
+{
+protected:
+    void SetUp() override { memset(&fakeMpu, 0, sizeof(fakeMpu)); }
+};
+
+// Reset values of MPU_CESR, S32K1xx Series Reference Manual Rev. 14, Table 15-4.
+uint32_t const CESR_RESET_S32K116_118     = 0x00812001U; // 8 region descriptors, NRGD = 0
+uint32_t const CESR_RESET_S32K142_144_146 = 0x00814001U; // 8 region descriptors, NRGD = 0
+uint32_t const CESR_RESET_S32K148         = 0x00815201U; // 16 region descriptors, NRGD = 2
+
+TEST_F(MpuTest, NumberOfRegionDescriptorsFollowsDeviceHeader)
+{
+    EXPECT_EQ(MPU_RGD_COUNT, mpu::SMPU_ENTRYS);
+    EXPECT_EQ(sizeof(fakeMpu.RGD) / sizeof(fakeMpu.RGD[0]), mpu::SMPU_ENTRYS);
+}
+
+TEST_F(MpuTest, IsGlobalEnabledForEveryNumberOfRegionDescriptors)
+{
+    fakeMpu.CESR = CESR_RESET_S32K148;
+    EXPECT_TRUE(mpu::isGlobalEnabled());
+
+    // Derivatives with 8 region descriptors report NRGD = 0 while the MPU is enabled
+    fakeMpu.CESR = CESR_RESET_S32K142_144_146;
+    EXPECT_TRUE(mpu::isGlobalEnabled());
+
+    fakeMpu.CESR = CESR_RESET_S32K116_118;
+    EXPECT_TRUE(mpu::isGlobalEnabled());
+
+    // NRGD = 1 (12 region descriptors) is defined by the reference manual as well
+    fakeMpu.CESR = MPU_CESR_NRGD(1U) | MPU_CESR_VLD(1U);
+    EXPECT_TRUE(mpu::isGlobalEnabled());
+}
+
+TEST_F(MpuTest, IsGlobalEnabledIsFalseWhenValidBitIsCleared)
+{
+    for (uint32_t nrgd = 0U; nrgd <= 2U; ++nrgd)
+    {
+        fakeMpu.CESR = MPU_CESR_NRGD(nrgd);
+        EXPECT_FALSE(mpu::isGlobalEnabled()) << "NRGD " << nrgd;
+    }
+}
+
+// The fake does not model CESR[NRGD] as read-only, so this checks the written bit directly.
+TEST_F(MpuTest, GlobalEnableAndDisableToggleValidBit)
+{
+    mpu::globalEnable();
+    EXPECT_EQ(MPU_CESR_VLD_MASK, fakeMpu.CESR & MPU_CESR_VLD_MASK);
+    mpu::globalDisable();
+    EXPECT_EQ(0U, fakeMpu.CESR & MPU_CESR_VLD_MASK);
+}
+
+TEST_F(MpuTest, SetWordInDescriptorWritesLastImplementedDescriptor)
+{
+    mpu::setWordInDescriptor<mpu::SMPU_ENTRYS - 1U, 2U, 0x12345678U>();
+    mpu::setWordInDescriptor<mpu::SMPU_ENTRYS - 1U, 3U, 0x00000001U>();
+
+    EXPECT_EQ(0x12345678U, fakeMpu.RGD[mpu::SMPU_ENTRYS - 1U].WORD2);
+    EXPECT_EQ(0x00000001U, fakeMpu.RGD[mpu::SMPU_ENTRYS - 1U].WORD3);
+}
+
+TEST_F(MpuTest, GetWordInDescriptorRejectsNotImplementedDescriptor)
+{
+    fakeMpu.RGD[mpu::SMPU_ENTRYS - 1U].WORD3 = 0xCAFEU;
+
+    EXPECT_EQ(0xCAFEU, mpu::getWordInDescriptor<3U>(mpu::SMPU_ENTRYS - 1U));
+    EXPECT_EQ(0U, mpu::getWordInDescriptor<3U>(mpu::SMPU_ENTRYS));
+}
+
+} // anonymous namespace
