diff --git a/executables/referenceApp/platforms/s32k148evb/safety/safeMemory/include/safeMemory/mpu.h b/executables/referenceApp/platforms/s32k148evb/safety/safeMemory/include/safeMemory/mpu.h
index 6c473005..467cad00 100644
--- a/executables/referenceApp/platforms/s32k148evb/safety/safeMemory/include/safeMemory/mpu.h
+++ b/executables/referenceApp/platforms/s32k148evb/safety/safeMemory/include/safeMemory/mpu.h
@@ -19,7 +19,10 @@ namespace safety
 {
 namespace mpu
 {
-static constexpr uint8_t SMPU_ENTRYS = 16U;
+// Number of region descriptors implemented by the derivative, taken from the device header
+// (S32K148: 16, S32K142/S32K144/S32K146: 8). Accessing a descriptor above this number results in
+// a bus fault.
+static constexpr uint8_t SMPU_ENTRYS = MPU_RGD_COUNT;
 
 enum class ReadAccess : uint8_t
 {
@@ -131,10 +134,9 @@ inline void globalDisable() { IP_MPU->CESR = MPU_CESR_VLD(0); }
 
 inline void globalEnable() { IP_MPU->CESR = MPU_CESR_VLD(1); }
 
-inline bool isGlobalEnabled()
-{
-    return ((IP_MPU->CESR & (MPU_CESR_NRGD_MASK | MPU_CESR_VLD_MASK)) == 0x201U);
-}
+// CESR[VLD] is the global enable bit. CESR[NRGD] is a read-only hardware configuration field
+// (number of region descriptors) and does not tell whether the MPU is enabled.
+inline bool isGlobalEnabled() { return ((IP_MPU->CESR & MPU_CESR_VLD_MASK) != 0U); }
 
 inline void setDescriptor(size_t const slot, Descriptor const& d)
 {
@@ -147,7 +149,7 @@ inline void setDescriptor(size_t const slot, Descriptor const& d)
 template<uint8_t slot, uint8_t wordNumber, uint32_t word>
 void setWordInDescriptor()
 {
-    static_assert(slot <= SMPU_ENTRYS, "");
+    static_assert(slot < SMPU_ENTRYS, "");
     if (wordNumber == 2U)
     {
         IP_MPU->RGD[slot].WORD2 = word;
diff --git a/executables/referenceApp/platforms/s32k148evb/safety/safeMemory/src/safeMemory/MemoryProtection.cpp b/executables/referenceApp/platforms/s32k148evb/safety/safeMemory/src/safeMemory/MemoryProtection.cpp
