    TYPE: SingleChoice(functional, non-functional)
    REQUIRED: True
  - TITLE: SOURCE
    TYPE: String
    REQUIRED: True
  - TITLE: STATUS
    TYPE: SingleChoice(implemented, partial, open, withdrawn)
    REQUIRED: True
  - TITLE: NOTE
    TYPE: String
    REQUIRED: False
